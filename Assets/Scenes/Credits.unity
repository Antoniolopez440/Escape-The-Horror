  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ZOMBIE MANSION\r\n\r\n\r\nA Full Sail University Project\r\n\r\n\r\n\r\nLEAD
    PROGRAMMER / SYSTEMS DESIGN\n\r\nAntonio Lopez\r\nNick Pitcher\nScott Sandler\n\r\n\r\n\r\nGAMEPLAY
    & FEATURE PROGRAMMING\r\n\r\nAntonio Lopez\nNick Pitcher\nScott Sandler\r\n\r\n\r\n\r\nGAMEPLAY
    / UI / BUILD INTEGRATION\r\n\r\nAntonio Lopez\nNick Pitcher\nScott Sandler\r\n\r\n\r\n\r\nCORE
    GAMEPLAY SYSTEMS\r\n\r\nInteraction System\r\nInventory System\r\nDoor & Gate
    Audio\r\nHidden Clues System\r\nFlashlight Toggle\r\nCode Entry Panel\r\nLocked
    Doors\r\n\r\n\r\n\r\nPLAYER & CONTROLS\r\n\r\nPlayer Character & Movement\r\nKeyboard
    & Mouse Input (In-Game)\r\nControls Tuning for WebGL Comfort\r\n\r\n\r\n\r\nWEAPONS
    & VEHICLES\r\n\r\nGuns\r\nGun UI\r\nGun Update\r\nVehicle\r\nCar / Vehicle Systems\r\nCar
    Key\r\nCar Parts\r\nCar Quest\r\n\r\n\r\n\r\nLEVELS & WORLD\r\n\r\nShowcase Level\r\nShed
    / Garage Setup\r\nCarl\u2019s Grandfather Grave Site\r\nGraveyard Touchups\r\nGrave
    Note\r\nGate / Escape\r\n\r\n\r\n\r\nENEMIES & COMBAT\r\n\r\nClassic Zombie AI\r\nBasic
    Zombie\r\nGraveyard Mini-Boss\r\nZombie Animations\r\nZombie Difficulty\r\n\r\n\r\n\r\nUI
    / MENUS / FLOW\r\n\r\nMenu System (Final Look & Functionality)\r\nNavigate the
    Main Menu\r\nPause Menu\r\nRestart\r\nGame Over Screen\r\nStarting Instruction
    Text\r\nIdentifiable Icon\r\n\r\n\r\n\r\n\r\nAUDIO\r\n\r\nBoss Music\r\nAmbient
    Music\r\nZombie Sounds\r\nAudio Feedback on Menus\r\nPlayer Footsteps\r\n\r\n\r\n\r\n\r\nThank
    you for playing."
  m_isRightToLeft: 0
